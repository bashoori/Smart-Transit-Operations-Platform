# ============================================================
# TransLink Smart Transit Platform — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it's in .gitignore
# ============================================================

# ── TransLink Open API ───────────────────────────────────────
TRANSLINK_API_KEY=your_translink_api_key_here
TRANSLINK_GTFS_URL=https://gtfs.translink.ca/v2/gtfs
TRANSLINK_GTFS_RT_URL=https://gtfs.translink.ca/v2/gtfsposition

# ── Database — Local PostgreSQL (Open Source Stack) ─────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=translink_platform
POSTGRES_USER=translink_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SCHEMA_BRONZE=bronze
POSTGRES_SCHEMA_SILVER=silver
POSTGRES_SCHEMA_GOLD=gold
POSTGRES_SCHEMA_MONITORING=monitoring

# ── Azure (Microsoft Stack) ──────────────────────────────────
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_service_principal_client_id
AZURE_CLIENT_SECRET=your_service_principal_secret

AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key
AZURE_CONTAINER_BRONZE=bronze
AZURE_CONTAINER_SILVER=silver
AZURE_CONTAINER_GOLD=gold

AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=translink_gold
AZURE_SQL_USERNAME=your_sql_user
AZURE_SQL_PASSWORD=your_sql_password

# ── Azure Data Factory ───────────────────────────────────────
ADF_RESOURCE_GROUP=rg-translink-platform
ADF_FACTORY_NAME=adf-translink-platform

# ── Databricks ───────────────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your_databricks_token
DATABRICKS_CLUSTER_ID=your_cluster_id
DATABRICKS_BRONZE_PATH=/mnt/datalake/bronze
DATABRICKS_SILVER_PATH=/mnt/datalake/silver
DATABRICKS_GOLD_PATH=/mnt/datalake/gold

# ── Microsoft Fabric ─────────────────────────────────────────
FABRIC_WORKSPACE_ID=your_fabric_workspace_id
FABRIC_LAKEHOUSE_ID=your_lakehouse_id
ONELAKE_ENDPOINT=https://onelake.dfs.fabric.microsoft.com

# ── Apache Airflow ───────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://translink_user:your_postgres_password_here@localhost:5432/airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_here
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW_HOME=/opt/airflow

# ── Weather API (Open-Meteo — no key required) ───────────────
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=49.2827
WEATHER_LONGITUDE=-123.1207
WEATHER_TIMEZONE=America/Vancouver

# ── Traffic API (HERE) ───────────────────────────────────────
HERE_API_KEY=your_here_api_key_here
HERE_TRAFFIC_URL=https://data.traffic.hereapi.com/v7/flow

# ── Data Paths — Local / Open Source Stack ──────────────────
DATA_ROOT=/data
BRONZE_PATH=/data/bronze
SILVER_PATH=/data/silver
GOLD_PATH=/data/gold
DEAD_LETTER_PATH=/data/dead_letter
GTFS_ZIP_PATH=/data/bronze/gtfs_zip

# ── Alerting ─────────────────────────────────────────────────
ALERT_EMAIL=data-alerts@your-domain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Slack webhook for pipeline failure alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── ML Model Paths ───────────────────────────────────────────
ML_MODEL_PATH=ml/models
RIDERSHIP_MODEL_FILE=ridership_forecast_model.pkl
DELAY_MODEL_FILE=delay_prediction_model.pkl

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
